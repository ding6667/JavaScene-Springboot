<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.amlve</groupId>
        <artifactId>JavaScene</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath> <!-- lookup parent from repository -->
    </parent>
    <artifactId>bootstrap</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>core</name>
    <description>core</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!--
            MyBatis-Plus 3.5.9 起，PaginationInnerInterceptor 等依赖 JSqlParser 的插件
            从 mybatis-plus-extension 拆到独立 artifact，starter 不再传递引入，
            需显式声明才能注册分页插件。版本与父 POM 的 mybatis-plus 3.5.17 对齐。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>3.5.17</version>
        </dependency>
        <dependency>
            <groupId>com.amlve</groupId>
            <artifactId>system</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.amlve</groupId>
            <artifactId>exam</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.amlve</groupId>
            <artifactId>dialogue</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.amlve</groupId>
            <artifactId>knowledge</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.amlve</groupId>
            <artifactId>study</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.amlve</groupId>
            <artifactId>teach</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.amlve</groupId>
            <artifactId>monitor</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.amlve</groupId>
            <artifactId>agent-analysis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.amlve</groupId>
            <artifactId>agent-code</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.amlve</groupId>
            <artifactId>agent-prepare</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.amlve</groupId>
            <artifactId>agent-qa</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.amlve</groupId>
            <artifactId>agent-question</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.amlve</groupId>
            <artifactId>agent-score</artifactId>
            <version>${project.version}</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>